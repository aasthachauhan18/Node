# ============================================
#         DATABASE CONNECTION STRING
# ============================================

# MONGO_URI is an environment variable
# It stores the MongoDB connection string.
# This tells mongoose where the database is located.

MONGO_URI=mongodb://127.0.0.1:27017/ABCD


# ============================================
#         SERVER PORT NUMBER
# ============================================

# PORT is the port number on which
# your Node.js server will run.

PORT=5000
